# Copy to an external .env; use distinct credentials from your secret manager.
SGLANG_API_KEY=replace-with-inference-key
SGLANG_ADMIN_API_KEY=replace-with-admin-key
HF_TOKEN=

# Bind to the address reachable by your existing gateway.
BIND_IP=127.0.0.1
PORT=30000
MODEL_CACHE_DIR=/opt/models/huggingface
# Dedicated directory; new namespace after model/engine/KV-format changes.
HICACHE_DIR=/opt/sglang/hicache/dsv4-vision-6821d6a-40b3e15

# 400 sessions; admission cap is independent of user/session count.
MAX_RUNNING_REQUESTS=128
MAX_QUEUED_REQUESTS=512
CUDA_GRAPH_MAX_BS=128
CHUNKED_PREFILL_SIZE=8192
MEM_FRACTION_STATIC=0.85
OMP_NUM_THREADS=16

# Host/device token ratio per rank. Sum all rank allocations on the HGX.
HICACHE_RATIO=1.25
# Decimal TB; valid suffix T, not TB. Keep filesystem quota <= 12 TB.
HICACHE_MAX_SIZE=10T
HICACHE_MIN_FREE_SPACE=3T
