# Copy to an external .env; use distinct credentials from your secret manager.
SGLANG_API_KEY=replace-with-inference-key
SGLANG_ADMIN_API_KEY=replace-with-admin-key
HF_TOKEN=

# Bind to the address reachable by your existing gateway.
BIND_IP=127.0.0.1
PORT=30000
MODEL_CACHE_DIR=/opt/models/huggingface
# Dedicated directory; new namespace after model/engine/KV-format changes.
HICACHE_DIR=/opt/sglang/hicache/dsv4-vision-6821d6a-40b3e15-dpa8

# TP8 / DP8 / DPA / EP1. Running and prefill CLI budgets are divided by DP8.
# 256 / 8 = 32 running sequences per rank; 32768 / 8 = 4096 prefill tokens.
MAX_RUNNING_REQUESTS=256
CHUNKED_PREFILL_SIZE=32768
# Queue is per DP scheduler: 64 x 8 = at most 512 waiting requests.
MAX_QUEUED_REQUESTS_PER_DP=64
# Decode graph cap is per DP rank; keep <= MAX_RUNNING_REQUESTS / 8.
CUDA_GRAPH_MAX_BS=32
MEM_FRACTION_STATIC=0.85
OMP_NUM_THREADS=16

# Host/device token ratio per rank. Sum all rank allocations on the HGX.
HICACHE_RATIO=1.25
# Eight writers share the directory and have independent LRU indexes.
# Decimal TB; T suffix. Mandatory aggregate filesystem quota <= 12 TB.
HICACHE_MAX_SIZE=10T
HICACHE_MIN_FREE_SPACE=3T

# Tracing and SMG. Use the same inference key in LiteLLM.
OTLP_UPSTREAM_ENDPOINT=otel.example.internal:4317
OTLP_UPSTREAM_INSECURE=false
SMG_BIND=127.0.0.1
SMG_PORT=30000
SMG_METRICS_PORT=29000
ENGINE_PORT=30001
OTLP_UPSTREAM_AUTHORIZATION=''
TELEMETRY_ENVIRONMENT=production

# Experiments only, in local .env: RESTART_POLICY=no

# Tracing and SMG. Use the same inference key in LiteLLM.

# Experiments only, in local .env: RESTART_POLICY=no
