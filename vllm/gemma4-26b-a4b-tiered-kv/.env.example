VLLM_IMAGE=vllm/vllm-openai:v0.26.0-cu129@sha256:976b4ba10e247dbe5c5ce3e2ba952a359ef641ee25c3d091811c1bec420e5a23
VLLM_SERVED_MODEL=gemma4-26b-a4b
VLLM_API_KEY=replace-with-a-random-secret

VLLM_BIND_IP=127.0.0.1
VLLM_PORT=8000
MODEL_DIR=/data/models/gemma-4-26B-A4B-it
ASSISTANT_MODEL_DIR=/data/models/gemma-4-26B-A4B-it-assistant
VLLM_CACHE_DIR=/data/vllm-cache
KV_CACHE_DIR=/data/vllm-kv-cache
BENCH_RESULTS_DIR=./results

# A100 80 GB throughput profile for mixed chat, document and image traffic.
EXPECTED_GPU_NAME=A100
MIN_GPU_MEMORY_MIB=79000
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=24
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.90
MAX_IMAGES_PER_PROMPT=4
MM_MAX_SOFT_TOKENS=1120
MM_PROCESSOR_CACHE_GB=4

# GPU -> 128 GiB RAM -> filesystem. Put KV_CACHE_DIR on quota-bounded NVMe.
KV_CPU_GIB=128
VLLM_SHM_GIB=144
KV_DISK_MIN_FREE_GB=512
KV_TRANSFER_CONFIG='{"kv_connector":"OffloadingConnector","kv_role":"kv_both","kv_connector_extra_config":{"spec_name":"TieringOffloadingSpec","eviction_policy":"lru","offload_prompt_only":true,"secondary_tiers":[{"type":"fs","root_dir":"/kv-cache","n_read_threads":32,"n_write_threads":16}]}}'

# vllm bench serve matrix: 5 concurrencies x 3 prompt lengths x 1024 output.
BENCH_CONCURRENCIES="2 4 8 16 32"
BENCH_INPUT_LENGTHS="8192 16384 32768"
BENCH_OUTPUT_LEN=1024
BENCH_REQUESTS_PER_USER=2
BENCH_NUM_WARMUPS=1

# Used only by the gemma4-mtp profile.
MTP_NUM_SPECULATIVE_TOKENS=4

# A100 supports CUDA forward compatibility. Driver 575+ can set this to 0.
VLLM_ENABLE_CUDA_COMPATIBILITY=1

# Tracing and SMG. Use the same inference key in LiteLLM.
SMG_BIND=127.0.0.1
SMG_PORT=30000
SMG_METRICS_PORT=29000
ENGINE_PORT=30001
OTLP_UPSTREAM_AUTHORIZATION=''
TELEMETRY_ENVIRONMENT=development

# Experiments only, in local .env: RESTART_POLICY=no
