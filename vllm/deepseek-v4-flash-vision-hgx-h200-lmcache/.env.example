VLLM_API_KEY=replace-with-inference-key
HF_TOKEN=
MODEL_CACHE_DIR=/opt/models/huggingface
LMCACHE_DISK_DIR=/opt/lmcache/dsv4-vision-6821d6a-65f80b25-21a5db10

# Per DP engine: 8 engines x 32 sequences = admission ceiling 256.
# Total context 400000; client input <=384000 including template/images,
# leaving 16000 tokens for reasoning + answer. Active capacity depends on KV.
MAX_NUM_SEQS=32
MAX_NUM_BATCHED_TOKENS=8192
CUDA_GRAPH_MAX_BS=32
# One API process; includes running and waiting requests across the instance.
MAX_INFLIGHT_REQUESTS=512
GPU_MEMORY_UTILIZATION=0.88
OMP_NUM_THREADS=8
MAX_IMAGES_PER_PROMPT=8
ALL2ALL_BACKEND=allgather_reducescatter

# One shared LMCache server. Values are GiB; never multiply them by DP8.
LMCACHE_RAM_GIB=1024
LMCACHE_DISK_GIB=8192
# Use an SSD filesystem/project quota of 10 TiB and retain >=3 TB free.
BUILD_MAX_JOBS=4

# Tracing and SMG. Use the same inference key in LiteLLM.
OTLP_UPSTREAM_ENDPOINT=otel.example.internal:4317
OTLP_UPSTREAM_INSECURE=false
SMG_BIND=127.0.0.1
SMG_PORT=30000
SMG_METRICS_PORT=29000
ENGINE_PORT=30001
OTLP_UPSTREAM_AUTHORIZATION=''
TELEMETRY_ENVIRONMENT=production
COLLECTOR_GRPC_PORT=14317
COLLECTOR_HTTP_PORT=14318

# Experiments only, in local .env: RESTART_POLICY=no
