# Copy to .env; paths are on the Docker host. The checked profile needs 48 GiB VRAM.
MODEL_DIR=/data/scratch/qwen38-sglang-smg/models/Qwen3.8-27B-FP8
SSD_CACHE_DIR=/data/scratch/qwen38-sglang-smg/hicache-fp8kv-bf16gdn-mtp
RUNTIME_CACHE_DIR=/data/scratch/qwen38-sglang-smg/runtime-cache
GPU_ID=0

# Set the host LAN address for remote clients, e.g. 192.168.0.59 on bx.
API_BIND=127.0.0.1
API_PORT=30000
METRICS_PORT=29000

# Published policy. Set to no in the local .env during experiments.
RESTART_POLICY=unless-stopped
KV_CACHE_DTYPE=fp8_e4m3
MAMBA_SSM_DTYPE=bfloat16
MAX_MAMBA_CACHE_SIZE=35
MAX_RUNNING_REQUESTS=8
MEM_FRACTION=0.94
CONTEXT_LENGTH=32768
CHUNKED_PREFILL_SIZE=2048
ENABLE_MTP=1
MTP_REPLAY_SSM=1
HOST_CACHE_GB=64
SSD_CACHE_SIZE=48Gi
SSD_MIN_FREE=20Gi
SMG_FALLBACK_TREE_TOKENS=131072
